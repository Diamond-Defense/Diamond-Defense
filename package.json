{
  "name": "diamond-defense",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:vite": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:cloudflare": "npm run dev:local",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "pretest": "npm run test:scripts",
    "test": "playwright test",
    "test:server": "node scripts/test-server.mjs",
    "test:database": "BASE_URL=http://127.0.0.1:8788 playwright test tests/database-api.spec.js",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:password-script": "node --test scripts/update-admin-password.test.mjs",
    "test:live": "playwright test tests/app.spec.js",
    "test:ui": "playwright test --ui",
    "db:seed:generate": "node scripts/generate-seed-sql.mjs",
    "db:migrate:local": "node scripts/wrangler-command.mjs d1 migrations apply diamond-defense --local --persist-to .wrangler/state",
    "db:seed:local": "node scripts/wrangler-command.mjs d1 execute diamond-defense --local --persist-to .wrangler/state --file=database/seed.sql",
    "db:migrate:preview": "node scripts/wrangler-command.mjs d1 migrations apply diamond-defense-preview --remote --env preview",
    "db:migrate:production": "node scripts/wrangler-command.mjs d1 migrations apply diamond-defense-production --remote --env production",
    "db:export:preview": "node scripts/wrangler-command.mjs d1 export diamond-defense-preview --remote --output=preview-database-export.sql",
    "db:export:production": "node scripts/wrangler-command.mjs d1 export diamond-defense-production --remote --output=production-database-export.sql",
    "admin:password": "node scripts/update-admin-password.mjs",
    "verify": "node scripts/verify.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.2.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "wrangler": "^4.28.1"
  }
}
